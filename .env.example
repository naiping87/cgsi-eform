# Dealer login password (shared password for all dealers)
LOGIN_PASSWORD=change-me

# SMTP Email Configuration (for sending signed PDFs)
#
# Gmail:     smtp.gmail.com   587   (需要开启 2FA + App Password)
# Office365: smtp.office365.com 587
# QQ Mail:   smtp.qq.com       587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
TO_EMAIL=dealer@example.com
